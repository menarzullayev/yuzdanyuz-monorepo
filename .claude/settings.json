{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(make *)",
      "Bash(./venv/bin/* *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pytest *)",
      "Bash(python *)",
      "Bash(./.claude/hooks/* *)",
      "Bash(/home/hsm/scripts/* *)",
      "Bash(/home/hsm/.local/pgsql/bin/* *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /home/*)",
      "Bash(*--no-verify*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(*credentials*)",
      "Read(*.key)",
      "Read(~/.ssh/id_*)",
      "Read(~/.git-credentials)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/PostToolUse.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/SessionStart.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/PreCompact.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "statusLine": {
    "type": "command",
    "command": ".claude/statusline"
  }
}
