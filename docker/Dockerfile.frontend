# syntax=docker/dockerfile:1.7
# Next.js web app (packages/frontend-web) as a standalone Node server on :3000.
# Used by docker-compose.prod.yml; nginx sends every path that is not Django's to it.
#
# The /api and /accounts rewrites in next.config.ts are resolved at build time, so
# API_URL is a build argument (the compose service name of the backend). In the compose
# stack nginx routes those paths to Django directly and the rewrites are only a fallback.

FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo

# npm workspaces: the lockfile is at the root and covers every package.json under packages/.
COPY package.json package-lock.json ./
COPY packages/frontend-web/package.json packages/frontend-web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --no-audit --no-fund

COPY packages/frontend-web/ packages/frontend-web/
COPY packages/shared/ packages/shared/

ARG API_URL=http://backend:8000
ARG NEXT_PUBLIC_BRAND_NAME=
RUN cd packages/frontend-web \
 && API_URL="$API_URL" NEXT_OUTPUT=standalone npm run build


FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# Standalone output keeps the workspace layout: server.js lives under packages/frontend-web.
COPY --from=build --chown=node:node /repo/packages/frontend-web/.next/standalone/ ./
COPY --from=build --chown=node:node /repo/packages/frontend-web/.next/static ./packages/frontend-web/.next/static
COPY --from=build --chown=node:node /repo/packages/frontend-web/public ./packages/frontend-web/public

ARG GIT_COMMIT_SHA=unknown
ENV GIT_COMMIT_SHA=${GIT_COMMIT_SHA}

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/uz/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "packages/frontend-web/server.js"]
