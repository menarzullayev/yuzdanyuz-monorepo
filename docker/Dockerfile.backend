# syntax=docker/dockerfile:1.7
# Multi-stage build for Django backend (also used for celery worker/beat).
# Image variants are differentiated by command, not by Dockerfile.

# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# psycopg2-binary, Pillow (libjpeg/zlib), cryptography (libssl), python-docx (libxml2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libjpeg-dev \
    zlib1g-dev \
    libssl-dev \
    libffi-dev \
    libxml2-dev \
    libxslt1-dev \
    git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY packages/backend/requirements/ /tmp/requirements/
RUN pip install --user -r /tmp/requirements/prod.txt


# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/app/.local/bin:${PATH}" \
    DJANGO_SETTINGS_MODULE=core.settings.prod

# Runtime deps only (no -dev)
# UID/GID 1000 must match securityContext.runAsUser/runAsGroup in
# charts/yuzdanyuz/values.yaml. With any other UID the pod user has no passwd
# entry: HOME becomes "/", Python cannot see /home/app/.local and the claude CLI
# has nowhere to write ~/.claude. scripts/smoke-backend-image.sh checks this.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libjpeg62-turbo \
    libxml2 \
    libxslt1.1 \
    curl \
    ca-certificates \
    tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r -g 1000 app && useradd -r -u 1000 -g app -d /home/app -m app

# Claude Code CLI for LLM_BACKEND=claude_cli (packages/backend/core/claude_cli.py).
# Pinned and checked against the SHA-256 from the release manifest
# (downloads.claude.ai/claude-code-releases/<version>/manifest.json, platform linux-x64).
# No login lives in the image: the container authenticates with CLAUDE_CODE_OAUTH_TOKEN,
# a one-year subscription token from `claude setup-token`.
ARG CLAUDE_CODE_VERSION=2.1.318
ARG CLAUDE_CODE_SHA256=708c77b204db30086ff6f1ed34577bda03e1be74ced80557cbf7b54249ebf0bd
RUN curl -fsSL -o /usr/local/bin/claude \
      "https://downloads.claude.ai/claude-code-releases/${CLAUDE_CODE_VERSION}/linux-x64/claude" \
 && echo "${CLAUDE_CODE_SHA256}  /usr/local/bin/claude" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/claude \
 && /usr/local/bin/claude --version
ENV DISABLE_AUTOUPDATER=1

WORKDIR /app

COPY --from=builder /root/.local /home/app/.local
COPY --chown=app:app packages/backend/ /app/
COPY --chown=app:app docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# OpenTelemetry auto-instrumentation hook (optional, opted in via OTEL_ENABLED)
ENV OTEL_ENABLED=false \
    OTEL_SERVICE_NAME=yuzdanyuz-backend \
    OTEL_TRACES_EXPORTER=otlp \
    OTEL_METRICS_EXPORTER=otlp \
    OTEL_LOGS_EXPORTER=none

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health/ || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["web"]
