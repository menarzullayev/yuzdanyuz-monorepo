# syntax=docker/dockerfile:1.7
# Nginx — reverse proxy for Django (web + asgi) + serves static assets.
# In K8s production, Ingress controller (nginx-ingress) usually replaces this,
# but useful for docker-compose dev parity.
#
# Runs as the image's unprivileged `nginx` user (uid 101) on port 8080; pid and temp
# files live in /tmp, so the container also works with a read-only root filesystem
# (the Helm chart mounts emptyDirs on /tmp, /var/cache/nginx and /etc/nginx/upstreams).

FROM nginx:1.27-alpine

RUN apk add --no-cache curl

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY docker/nginx/templates/ /etc/nginx/templates/

# Upstream hosts: compose service names by default; the Helm chart sets the
# <release>-web / <release>-channels Service names. The stock entrypoint renders
# /etc/nginx/templates/*.template into NGINX_ENVSUBST_OUTPUT_DIR; the filter keeps
# envsubst away from nginx's own $variables.
ENV BACKEND_UPSTREAM=backend:8000 \
    CHANNELS_UPSTREAM=channels:8000 \
    NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/upstreams \
    NGINX_ENVSUBST_FILTER=_UPSTREAM

# Static + media volumes mounted at runtime; dirs the non-root process writes to.
RUN mkdir -p /var/www/static /var/www/media /etc/nginx/upstreams \
 && chown -R nginx:nginx /var/cache/nginx /etc/nginx/upstreams

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/health/ || exit 1
