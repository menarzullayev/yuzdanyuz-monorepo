# =============================================================================
# YuzDanYuz Frontend — environment template
# Copy to .env.local for development. Set in Vercel dashboard for production.
# NEXT_PUBLIC_* vars are exposed to the browser — NEVER put secrets here.
# =============================================================================

# Backend API (Django on Hestia subpath, or local dev server)
NEXT_PUBLIC_API_BASE_URL=https://hsm.sammu.uz/yuzdanyuz

# WebSocket / SSE base URL (currently same — SSE works over HTTP/1.1)
# Per docs/websocket_strategy.md, SSE replaces WebSocket in this deployment.
NEXT_PUBLIC_SSE_BASE_URL=https://hsm.sammu.uz/yuzdanyuz

# Default locale (uz-Latn, uz-Cyrl, ru, en)
NEXT_PUBLIC_DEFAULT_LOCALE=uz-Latn

# Sentry frontend (set when launching — leave empty in dev)
NEXT_PUBLIC_SENTRY_DSN=

# Vercel build metadata (auto-set in Vercel; manual override for self-host)
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_COMMIT_SHA=

# Feature flags (toggle UI experiments without redeploy)
NEXT_PUBLIC_FEATURE_AI_TUTOR=true
NEXT_PUBLIC_FEATURE_LEADERBOARD_LIVE=true
