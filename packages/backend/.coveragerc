[run]
source = apps,core
omit =
    */migrations/*
    */tests/*
    */tests.py
    */__pycache__/*
    */venv/*
    */node_modules/*
    manage.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:
show_missing = True
skip_covered = False
precision = 1
