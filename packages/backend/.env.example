# Backend environment template.
#
#   cp packages/backend/.env.example packages/backend/.env   # local dev / docker compose
#
# In Kubernetes the same keys come from the chart ConfigMap (charts/yuzdanyuz/values.yaml
# `env`) and the out-of-band Secret `yuzdanyuz-secrets` (docs/deployment/secrets.md).
#
# Every key the backend reads is listed here; CI fails when a new os.getenv() key is
# missing (scripts/check_env_example.py, tests/unit/test_env_example.py).
# Uncommented = set it. Commented = optional, the value shown is the default.
# [prod: required] = core/settings/prod.py refuses to start without it.

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_ENV=dev                                  # dev | prod (prod also for staging)
# DJANGO_SETTINGS_MODULE=core.settings          # image default: core.settings.prod
SECRET_KEY=change-me-50-random-chars            # [prod: required]
ALLOWED_HOSTS=                                  # [prod: required] comma-separated public hosts
# CSRF_TRUSTED_ORIGINS=                         # https://yuzdanyuz.uz,https://api.yuzdanyuz.uz
# CORS_ALLOWED_ORIGINS=                         # frontend origins, comma-separated
# FORCE_SCRIPT_NAME=                            # subpath deploy, e.g. /yuzdanyuz
# FRONTEND_BASE_URL=http://localhost:3000
# API_PUBLIC_URL=                               # public API base URL used in links
# POD_IP=                                       # set by the chart (downward API)
# PROJECT_BRAND_NAME=Milliy Sertifikat
# PLATFORM_ORG_SLUG=platform
# TERMS_VERSION=2026-11-12
# GDPR_ERASURE_COOLING_OFF_HOURS=72
# CSP_REPORT_URI=                              # Content-Security-Policy report endpoint

# ── Reverse proxy / client IP ────────────────────────────────────────────────
TRUSTED_PROXY_CIDRS=                            # [prod: required] ingress pod CIDR + Cloudflare ranges

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=yuzdanyuz_db
DB_USER=yuzdanyuz
DB_PASSWORD=yuzdanyuz_dev                       # [prod: required]
DB_HOST=127.0.0.1                               # [prod: required] not `localhost`
DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_RUNTIME_ROLE=                             # migrate Job only: role that gets DML grants (core/db_roles.py)
# DB_DEFINER_ROLE=yuzdanyuz_definer            # NOLOGIN BYPASSRLS owner of RLS helper functions (ops.0003)
ENABLE_RLS=true
# TEST_DB_NAME=yuzdanyuz_test                   # pytest only

# ── Redis / Celery / Channels ────────────────────────────────────────────────
REDIS_URL=redis://:<redis-password>@127.0.0.1:6379/1           # [prod: required]
CELERY_BROKER_URL=redis://:<redis-password>@127.0.0.1:6379/0   # [prod: required]
CHANNELS_REDIS_URL=redis://:<redis-password>@127.0.0.1:6379/2
# REDIS_CACHE_URL=                             # default: REDIS_URL host, db 3

# ── Field encryption ─────────────────────────────────────────────────────────
# FIELD_ENCRYPTION_KEY=                         # Fernet key for encrypted model fields
# FIELD_ENCRYPTION_KEYS=                        # comma-separated Fernet keys, newest first (rotation)
# TOTP_ENCRYPTION_KEY=                          # Fernet key for 2FA secrets

# ── Auth / sessions ──────────────────────────────────────────────────────────
# AUTH_MAX_DEVICES=3
# AUTH_SESSION_HOURS=24
# AUTH_REMEMBER_DAYS=30
# AUTH_REFRESH_COOKIE_PATH=/api/auth/
# LOGIN_FAILURE_FREE_ATTEMPTS=5
# LOGIN_GLOBAL_FREE_ATTEMPTS=20
# LOGIN_FAILURE_WINDOW_SECONDS=3600
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Telegram bot ─────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=                        # [prod: required] random string
# OPS_TELEGRAM_CHANNEL_ID=                      # status-page alerts channel
# OPS_ADMIN_CHAT_IDS=                           # comma-separated admin chat ids
# OPS_PROBE_AI=false

# ── SMS / OTP ────────────────────────────────────────────────────────────────
# ENABLE_SMS_OTP=false
# SMS_BACKEND=console                           # console | playmobile | eskiz
# PLAYMOBILE_LOGIN=
# PLAYMOBILE_PASSWORD=
# PLAYMOBILE_ORIGINATOR=MilSert
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_SENDER=4546

# ── Email (prod SMTP) ────────────────────────────────────────────────────────
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@milliysertifikat.uz

# ── Payments / billing ───────────────────────────────────────────────────────
# ENABLE_REAL_PAYMENTS=false
# PAYME_SECRET_KEY=                             # falls back to PAYME_MERCHANT_KEY
# PAYME_MERCHANT_KEY=
# CLICK_SECRET_KEY=
# BILLING_ENFORCE_EXAM_ACCESS=false
# BILLING_FREE_ATTEMPTS=3
# BILLING_WEEK_TZ=Asia/Tashkent

# ── AI ───────────────────────────────────────────────────────────────────────
# ENABLE_AI_PARSER=true
# LLM_BACKEND=claude_cli                        # claude_cli | anthropic_api
# CLAUDE_CODE_OAUTH_TOKEN=                      # `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN_EXPIRES=              # YYYY-MM-DD
# CLAUDE_CLI_PATH=
# CLAUDE_CLI_TIMEOUT=300
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_PROVIDER_PRIVATE_HOSTS=                   # comma-separated hosts an AIProviderConfig.base_url may resolve to privately

# ── Observability ────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# ACCESS_LOG_LEVEL=INFO                         # yuzdanyuz.access JSON lines (WARNING = errors only)
# EVENTS_LOG_LEVEL=INFO
# DB_LOG_LEVEL=WARNING
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=                           # defaults to DJANGO_ENV
# SENTRY_RELEASE=                               # defaults to GIT_COMMIT_SHA
# GIT_COMMIT_SHA=                               # baked into the image by CI
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# HEALTH_DEEP_TOKEN=                            # X-Health-Token for /health/ready/?deep=1; empty = disabled
# PROMETHEUS_MULTIPROC_DIR=                     # set by docker/entrypoint.sh (web, worker); sums all processes
# CELERY_METRICS_PORT=9540                      # worker metrics server (entrypoint default)
